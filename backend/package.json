{
  "name": "email-checker-backend",
  "version": "1.0.0",
  "description": "Backend API for email validation and file sharing",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "set PORT=5003 && nodemon src/server.js",
    "check-frontend": "node checkFrontend.js",
    "seed:config": "node scripts/seedConfig.js",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "clean": "node ../scripts/clean-cache.mjs --verbose",
    "reinstall": "npm run clean && npm ci --legacy-peer-deps"
  },
  "dependencies": {
    "axios": "^1.6.2",
    "bullmq": "^4.15.4",
    "cheerio": "^1.1.2",
    "cors": "^2.8.5",
    "disposable-email-domains": "^1.0.62",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "lru-cache": "^10.0.0",
    "mongoose": "^8.0.3",
    "multer": "^2.0.0-rc.4",
    "node-fetch": "^3.3.2",
    "punycode": "^2.3.1",
    "uuid": "^9.0.1",
    "winston": "^3.11.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "email",
    "validation",
    "api",
    "express"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "@jest/globals": "^30.1.2",
    "babel-jest": "^29.7.0",
    "jest": "^30.1.3",
    "jsdom": "^23.0.1",
    "nodemon": "^3.1.0",
    "supertest": "^7.1.4"
  }
}
